{
  "expo": {
    "name": "SpiderNote",
    "owner": "totemn",
    "slug": "spidernote",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spidernote",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.totemn.spidernote",
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#17132D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#17132D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow SpiderNote to record the thoughts you choose to capture.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-asset",
      [
        "expo-navigation-bar",
        { "hidden": true, "style": "light", "enforceContrast": false }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0645aa00-3788-4d8d-ba29-3dbb490147fa"
      }
    }
  }
}
