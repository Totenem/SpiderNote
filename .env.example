# Copy to .env.local in this project root. .env.local is ignored by Git.
# These TWO public values are bundled into the app; set before building an APK.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=

# SERVER ONLY. Never prefix these with EXPO_PUBLIC_.
# EAS Hosting: store in the matching EAS environment as Sensitive, not Secret.
GROQ_API_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
# Optional networkless JWT verification: PEM public key, with literal \n escapes.
CLERK_JWT_KEY=
# Optional comma-separated web origins; native tokens may omit azp.
CLERK_AUTHORIZED_PARTIES=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Your exact Clerk user_... ID(s), from Clerk Dashboard > Users.
SPIDERNOTE_DEV_CLERK_USER_IDS=

# Server-wide cost limits (UTC day), in addition to 3/minute and 30/day/user.
AI_GLOBAL_DAILY_CHAR_LIMIT=200000
AI_GLOBAL_DAILY_REQUEST_LIMIT=100
